{
	"$schema": "https://turborepo.dev/schema.json",
	"agentGuidance": false,
	"futureFlags": {
		"experimentalCargoWorkspaces": true,
		"experimentalTaskCommand": true
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {},
		"test": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"korr-rust#lint": {
			"command": [
				"cargo",
				"clippy",
				"--workspace",
				"--all-targets",
				"--locked",
				"--",
				"-D",
				"warnings"
			]
		},
		"korr-rust#format": {
			"command": ["cargo", "fmt", "--all", "--check"]
		}
	}
}
