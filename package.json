{
	"name": "korr-aelvein",
	"private": true,
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check:arch": "bun scripts/check-architecture.ts",
		"verify": "biome check . && bun run check:arch && turbo run typecheck test build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"turbo": "2.11.7",
		"typescript": "7.0.2"
	}
}
